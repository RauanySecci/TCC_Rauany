   "source": [
    "def preparar_dados_mongo():\n",
    "    # Conversão dos dados para o formato do MongoDB: feita FORA da medição\n",
    "    agora = datetime.now()  # equivale ao DEFAULT now() do PostgreSQL\n",
    "    docs_restaurantes = [\n",
    "        {\n",
    "            \"_id\": r[\"mongo_id\"],\n",
    "            \"nome\": r[\"nome\"],\n",
    "            \"categoria\": r[\"categoria\"],\n",
    "            \"ativo\": r[\"ativo\"],\n",
    "            \"criado_em\": agora,\n",
    "        }\n",
    "        for r in restaurantes\n",
    "    ]\n",
    "\n",
    "    docs_itens = []\n",
    "    for it in itens:\n",
    "        doc = {\n",
    "            \"restauranteId\": it[\"restaurante\"][\"mongo_id\"],\n",
    "            \"nome\": it[\"nome\"],\n",
    "            \"categoria\": it[\"categoria\"],\n",
    "            \"status\": it[\"status\"],\n",
    "            \"preco\": it[\"preco\"],\n",
    "            \"opcoes_grupos\": it[\"opcoes_grupos\"],\n",
    "            \"hash\": it[\"hash\"],\n",
    "            \"versao\": it[\"versao\"],\n",
    "            \"criado_em\": agora,\n",
    "            \"modificado_em\": agora,\n",
    "        }\n",
    "        doc.update(it[\"atributos\"])  # adiciona os campos descritivos direto no documento\n",
    "        docs_itens.append(doc)\n",
    "    return docs_restaurantes, docs_itens\n",
    "\n",
    "\n",
    "docs_restaurantes_mongo, docs_itens_mongo = preparar_dados_mongo()\n",
    "\n",
    "\n",
    "def inserir_mongo():\n",
    "    # Só o envio ao banco é cronometrado: inserção em lotes do mesmo tamanho do PostgreSQL\n",
    "    db_mongo.restaurantes.insert_many(docs_restaurantes_mongo)\n",
    "    for i in range(0, len(docs_itens_mongo), TAMANHO_LOTE):\n",
    "        db_mongo.itens.insert_many(docs_itens_mongo[i:i + TAMANHO_LOTE])\n",
    "\n",
    "\n",
    "resultado_insercao_mongo = medir_insercao_com_recursos(inserir_mongo, \"catalogo-mongo-db\")\n",
    "espaco_dados_mongo_depois = medir_espaco_dados_mongo(\"itens\")\n",
    "tamanho_logico_mongo_depois = medir_tamanho_logico_mongo(\"itens\")\n",
    "\n",
    "\n",
    "print(f\"MongoDB: {len(restaurantes)} restaurantes e {len(itens)} itens inseridos.\")\n",
    "print(f\"Tempo total: {resultado_insercao_mongo['tempo_total_ms']:.0f} ms\")\n",
    "print(f\"CPU média: {resultado_insercao_mongo['cpu_media_percent']:.2f}% (máx: {resultado_insercao_mongo['cpu_max_percent']:.2f}%)\")\n",
    "print(f\"Memória média: {resultado_insercao_mongo['memoria_media_mb']:.2f} MB (máx: {resultado_insercao_mongo['memoria_max_mb']:.2f} MB)\")\n",
    "print(f\"Amostras coletadas: {resultado_insercao_mongo['num_amostras']}\")\n",
    "print(f\"CPUs brutos: {resultado_insercao_mongo['cpus_brutos']}\")\n",
    "print(f\"Memórias brutas: {resultado_insercao_mongo['memorias_brutas']}\")\n",
    "print(f\"Espaço ocupado pelos dados (em disco, comprimido): {espaco_dados_mongo_depois:.2f} MB\")\n",
    "print(f\"Tamanho lógico dos dados (sem compressão): {tamanho_logico_mongo_depois:.2f} MB\")"
   ]
  },
