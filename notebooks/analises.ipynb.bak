   "source": [
    "# Cria o índice compound (equivalente ao B-tree composto) para C1\n",
    "db_mongo.itens.drop_indexes()\n",
    "db_mongo.itens.create_index([(\"categoria\", 1), (\"status\", 1)], name=\"btree_c1\")\n",
    "\n",
    "# Confirma o plano de execução\n",
    "plano_c1_mongo_btree = explain_c1_mongo()\n",
    "stage = encontrar_estagio_scan(plano_c1_mongo_btree[\"queryPlanner\"][\"winningPlan\"])\n",
    "indice_usado = extrair_nome_indice(plano_c1_mongo_btree)\n",
    "\n",
    "print(f\"Índice: {indice_usado} | Tipo de acesso: {stage}\")\n",
    "\n",
    "# Mede o tempo de execução\n",
    "resultado_c1_mongo_btree = medir_tempo(consulta_c1_mongo, repeats=10)\n",
    "print(f\"Min: {resultado_c1_mongo_btree['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c1_mongo_btree['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c1_mongo_btree['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c1_mongo_btree['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c1_mongo_btree['tempos_brutos']}\")\n",
    "\n",
    "# Mede o espaço em disco ocupado pelo índice\n",
    "espaco_indice_c1_mongo = medir_espaco_indice_mongo(\"itens\")\n",
    "print(f\"Espaço ocupado pelo índice: {espaco_indice_c1_mongo:.2f} MB\")"
   ]
