    "apagar_indices_pg()  # remove qualquer índice\n",
    "\n",
    "def consulta_c6_pg():\n",
    "    return pd.read_sql(\n",
    "        \"SELECT nome, categoria, atributos_variaveis->'promocao' AS promocao FROM itens \"\n",
    "        \"WHERE atributos_variaveis ? 'promocao' AND status <> 'DELETED'\",\n",
    "        engine_pg\n",
    "    )\n",
    "\n",
    "def explain_c6_pg():\n",
    "    with engine_pg.connect() as conn:\n",
    "        resultado = conn.execute(text(\n",
    "            \"EXPLAIN (ANALYZE, FORMAT JSON) SELECT nome, categoria, atributos_variaveis->'promocao' AS promocao FROM itens \"\n",
    "            \"WHERE atributos_variaveis ? 'promocao' AND status <> 'DELETED'\"\n",
    "        )).scalar()\n",
    "        return resultado[0]\n",
    "\n",
    "# Inspeciona os dados\n",
    "df_c6_pg = consulta_c6_pg()\n",
    "print(f\"PostgreSQL: {len(df_c6_pg)} itens encontrados\")\n",
    "display(df_c6_pg.head())\n",
    "\n",
    "# Confirma o plano de execução\n",
    "plano_c6_pg = explain_c6_pg()\n",
    "node_type = plano_c6_pg[\"Plan\"][\"Node Type\"]\n",
    "print(f\"Tipo de acesso usado: {node_type}\")\n",
    "\n",
    "# Mede o tempo de execução\n",
    "resultado_c6_pg_sem_indice = medir_tempo(consulta_c6_pg, repeats=10)\n",
    "print(f\"Min: {resultado_c6_pg_sem_indice['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c6_pg_sem_indice['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c6_pg_sem_indice['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c6_pg_sem_indice['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c6_pg_sem_indice['tempos_brutos']}\")"
   ]
  },
