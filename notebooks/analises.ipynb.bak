    "\n",
    "resultado_c4_pg_btree = medir_tempo(consulta_c4_pg, repeats=10)\n",
    "print(f\"Min: {resultado_c4_pg_btree['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c4_pg_btree['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c4_pg_btree['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c4_pg_btree['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c4_pg_btree['tempos_brutos']}\")\n",
    "\n",
    "espaco_indice_c4_pg = medir_espaco_indice_pg(\"itens\")\n",
    "print(f\"Espaço ocupado pelo índice: {espaco_indice_c4_pg:.2f} MB\")"
   ]
