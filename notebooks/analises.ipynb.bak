   ],
   "source": [
    "apagar_indices_pg()  # remove qualquer índice\n",
    "\n",
    "def consulta_c5_pg(minimo=20, maximo=50):\n",
    "    return pd.read_sql(\n",
    "        text(\n",
    "            \"SELECT nome, categoria, preco FROM itens \"\n",
    "            \"WHERE (preco->>'valor')::numeric BETWEEN :minimo AND :maximo AND status <> 'DELETED'\"\n",
    "        ),\n",
    "        engine_pg,\n",
    "        params={\"minimo\": minimo, \"maximo\": maximo}\n",
    "    )\n",
    "\n",
    "def explain_c5_pg(minimo=20, maximo=50):\n",
    "    with engine_pg.connect() as conn:\n",
    "        resultado = conn.execute(text(\n",
    "            \"EXPLAIN (ANALYZE, FORMAT JSON) SELECT nome, categoria, preco FROM itens \"\n",
    "            \"WHERE (preco->>'valor')::numeric BETWEEN :minimo AND :maximo AND status <> 'DELETED'\"\n",
    "        ), {\"minimo\": minimo, \"maximo\": maximo}).scalar()\n",
    "        return resultado[0]\n",
    "\n",
    "# Inspeciona os dados\n",
    "df_c5_pg = consulta_c5_pg()\n",
    "print(f\"PostgreSQL: {len(df_c5_pg)} itens encontrados\")\n",
    "display(df_c5_pg.head())\n",
    "\n",
    "# Confirma o plano de execução\n",
    "plano_c5_pg = explain_c5_pg()\n",
    "node_type = plano_c5_pg[\"Plan\"][\"Node Type\"]\n",
    "print(f\"Tipo de acesso usado: {node_type}\")\n",
    "\n",
    "# Mede o tempo de execução\n",
    "resultado_c5_pg_sem_indice = medir_tempo(consulta_c5_pg, repeats=10)\n",
    "print(f\"Min: {resultado_c5_pg_sem_indice['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c5_pg_sem_indice['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c5_pg_sem_indice['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c5_pg_sem_indice['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c5_pg_sem_indice['tempos_brutos']}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "2bba0798",
   "metadata": {},
   "source": [
    "###### <span style=\"font-size:1.6em\">PostgreSQL - Índice B-Tree (simples)</span>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "8b8e3192",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Índices removidos: nenhum\n",
      "Índice: nenhum | Tipo de acesso: Seq Scan\n",
      "Min: 3285.41 ms\n",
      "Max: 7448.62 ms\n",
      "Média: 4832.23 ms\n",
      "Mediana: 4609.53 ms\n",
      "Tempos brutos: [7448.617208999622, 4052.6249079998706, 7261.679142000048, 4521.55576899986, 4697.496200999922, 4971.068722999917, 3442.2422030002053, 5125.036081999951, 3516.591017999872, 3285.4117629999564]\n",
      "Espaço ocupado pelo índice: 21.48 MB\n"
     ]
    }
   ],
   "source": [
    "apagar_indices_pg()  # remove qualquer índice\n",
    "\n",
    "# Cria o índice de expressão sobre o valor extraído do JSONB\n",
    "with engine_pg.begin() as conn:\n",
    "    conn.execute(text(\n",
    "        \"CREATE INDEX btree_c5 ON itens (((preco->>'valor')::numeric))\"\n",
    "    ))\n",
    "    conn.execute(text(\"ANALYZE itens\"))\n",
    "\n",
    "# Confirma o plano de execução\n",
    "plano_c5_pg_btree = explain_c5_pg()\n",
    "node_type = plano_c5_pg_btree[\"Plan\"][\"Node Type\"]\n",
    "indice_usado = extrair_nome_indice(plano_c5_pg_btree)\n",
    "print(f\"Índice: {indice_usado} | Tipo de acesso: {node_type}\")\n",
    "\n",
    "# Mede o tempo de execução\n",
    "resultado_c5_pg_btree = medir_tempo(consulta_c5_pg, repeats=10)\n",
    "print(f\"Min: {resultado_c5_pg_btree['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c5_pg_btree['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c5_pg_btree['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c5_pg_btree['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c5_pg_btree['tempos_brutos']}\")\n",
    "\n",
    "# Mede o espaço em disco ocupado pelo índice\n",
    "espaco_indice_c5_pg = medir_espaco_indice_pg(\"itens\")\n",
    "print(f\"Espaço ocupado pelo índice: {espaco_indice_c5_pg:.2f} MB\")"
   ]
  },
