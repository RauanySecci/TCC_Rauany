     ]
    }
   ],
   "source": [
    "apagar_indices_pg()  # remove qualquer índice\n",
    "\n",
    "with engine_pg.begin() as conn:\n",
    "    conn.execute(text(\n",
    "        \"CREATE INDEX gin_c6 ON itens USING GIN (atributos_variaveis)\"\n",
    "    ))\n",
    "    conn.execute(text(\"ANALYZE itens\"))\n",
    "\n",
    "plano_c6_pg_gin = explain_c6_pg()\n",
    "node_type = plano_c6_pg_gin[\"Plan\"][\"Node Type\"]\n",
    "indice_usado = extrair_nome_indice(plano_c6_pg_gin)\n",
    "print(f\"Índice: {indice_usado} | Tipo de acesso: {node_type}\")\n",
    "\n",
    "resultado_c6_pg_gin = medir_tempo(consulta_c6_pg, repeats=10)\n",
    "print(f\"Min: {resultado_c6_pg_gin['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c6_pg_gin['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c6_pg_gin['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c6_pg_gin['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c6_pg_gin['tempos_brutos']}\")\n",
    "\n",
    "espaco_indice_c6_pg_gin = medir_espaco_indice_pg(\"itens\")\n",
    "print(f\"Espaço ocupado pelo índice: {espaco_indice_c6_pg_gin:.2f} MB\")"
   ]
