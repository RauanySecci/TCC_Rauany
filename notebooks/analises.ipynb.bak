   "source": [
    "CAMINHO_RESULTADOS_VOLUME = \"resultados_volume.json\"\n",
    "\n",
    "def preparar_ambiente(num_restaurantes, num_itens):\n",
    "    resetar_schema()\n",
    "    gerar_dados(num_restaurantes, num_itens)\n",
    "    inserir_postgres()\n",
    "    inserir_mongo()\n",
    "\n",
    "\n",
    "resultados_volume = {}  # {preset: {consulta: {cenario: resultado_medir_tempo}}}\n",
    "\n",
    "for nome_preset, (num_rest, num_it) in PRESETS.items():\n",
    "    print(f\"\\n=== Volume: {nome_preset} ({num_rest} restaurantes, {num_it} itens) ===\")\n",
    "    preparar_ambiente(num_rest, num_it)\n",
    "\n",
    "    resultados_volume[nome_preset] = {}\n",
    "    for nome_consulta, cenarios in CENARIOS_ESCALABILIDADE.items():\n",
    "        resultados_volume[nome_preset][nome_consulta] = {}\n",
    "        for cenario in cenarios:\n",
    "            cenario[\"preparar\"]()\n",
    "            resultado = medir_tempo(cenario[\"acao\"], repeats=10, antes=cenario.get(\"antes\"))\n",
    "            resultados_volume[nome_preset][nome_consulta][cenario[\"label\"]] = resultado\n",
    "            print(f\"{nome_consulta} | {cenario['label']}: média {resultado['media']:.2f} ms (mediana {resultado['mediana']:.2f} ms)\")\n",
    "\n",
    "    with open(CAMINHO_RESULTADOS_VOLUME, \"w\", encoding=\"utf-8\") as f:\n",
    "        json.dump(resultados_volume, f, ensure_ascii=False, indent=2)\n",
    "    print(f\"Resultados salvos em {CAMINHO_RESULTADOS_VOLUME} (até o volume {nome_preset}).\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "be2c7f65",
   "metadata": {},
   "source": [
    "### Seletividade"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9e45c011",
   "metadata": {},
   "source": [
    "Reaproveita os `preparar_*` e o `CENARIOS_ESCALABILIDADE` definidos na seção de volume: para cada cenário (ex.: *PostgreSQL - Índice B-Tree*), prepara o índice **uma vez** e mede a mesma consulta com parâmetros que retornam quantidades diferentes de linhas. O volume do banco fica fixo (`PRESET_SELETIVIDADE`); só o valor filtrado muda.\n",
    "\n",
    "| Consulta | Parâmetro variado |\n",
    "|---|---|\n",
    "| C1 | categoria (`sobremesa` ~10%, `bebida` ~20%, `pizza`/`lanche` ~35%) |\n",
    "| C5 | largura da faixa de preço |\n",
    "| C4 | restaurante pequeno, médio e grande (quantidade de itens diferente) |\n",
    "| C7 | opção do grupo (`Cheddar extra` ~25% dos restaurantes, `Bacon extra` ~60%) |\n",
    "\n",
    "Como a seletividade real depende dos dados, cada medição também guarda `n_resultados` (linhas retornadas)."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cc0221f7",
   "metadata": {},
   "source": [
    "##### Preparando Cenários"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "c1a1003e",
   "metadata": {},
   "outputs": [],
   "source": [
    "CAMINHO_RESULTADOS_SELETIVIDADE = \"resultados_seletividade.json\"\n",
    "PRESET_SELETIVIDADE = \"Grande\"  # volume fixo em que a seletividade é medida\n",
    "\n",
    "def preparar_ambiente(num_restaurantes, num_itens):\n",
    "    resetar_schema()\n",
    "    gerar_dados(num_restaurantes, num_itens)\n",
    "    inserir_postgres()\n",
    "    inserir_mongo()\n",
    "\n",
    "def restaurante_por_porte(porte):\n",
    "    return next(r for r in restaurantes if r[\"porte\"] == porte)\n",
    "\n",
    "# Depois de gerar_dados(), pois C4 depende dos restaurantes gerados.\n",
    "# Cada parâmetro é (rótulo, argumento(s) passados à consulta).\n",
    "def montar_parametros_seletividade():\n",
    "    return {\n",
    "        \"C1\": [(cat, cat) for cat in [\"sobremesa\", \"bebida\", \"pizza\"]],\n",
    "        \"C5\": [\n",
    "            (\"R$ 5–12\", {\"minimo\": 5, \"maximo\": 12}),\n",
    "            (\"R$ 5–25\", {\"minimo\": 5, \"maximo\": 25}),\n",
    "            (\"R$ 5–50\", {\"minimo\": 5, \"maximo\": 50}),\n",
    "            (\"R$ 5–70\", {\"minimo\": 5, \"maximo\": 70}),\n",
    "        ],\n",
    "        \"C4\": [\n",
    "            (\"pequeno\", restaurantes[0][\"nome\"]),\n",
    "            (\"medio\", restaurante_por_porte(\"medio\")[\"nome\"]),\n",
    "            (\"grande\", restaurantes[1][\"nome\"]),\n",
    "        ],\n",
    "        \"C7\": [(\"Cheddar extra\", \"Cheddar extra\"), (\"Bacon extra\", \"Bacon extra\")],\n",
    "    }\n",
    "\n",
    "def chamar(acao, valor):\n",
    "    # valor dict -> argumentos nomeados (C5); caso contrário, argumento posicional único\n",
    "    return acao(**valor) if isinstance(valor, dict) else acao(valor)"
   ]
  },
  {
