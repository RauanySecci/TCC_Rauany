   "source": [
    "###### <span style=\"font-size:1.6em\">PostgreSQL - Índice GIN</span>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d3db0350",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Índices removidos: nenhum\n",
