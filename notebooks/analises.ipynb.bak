  {
   "cell_type": "markdown",
   "id": "04c95054",
   "metadata": {},
   "source": [
    "### PostgreSQL"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "f15ec780",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "PostgreSQL: 1000 restaurantes e 1000000 itens inseridos.\n",
      "Tempo total: 72457 ms\n",
      "CPU média: 78.65% (máx: 92.43%)\n",
      "Memória média: 454.51 MB (máx: 1004.00 MB)\n",
      "Amostras coletadas: 36\n",
      "CPUs brutos: [87.01, 72.42, 87.53, 87.87, 89.85, 78.79, 76.61, 73.31, 88.72, 88.72, 89.98, 88.21, 89.63, 89.96, 91.84, 90.44, 84.2, 77.76, 78.54, 90.6, 79.93, 79.75, 73.0, 58.26, 77.04, 92.43, 86.25, 83.82, 83.17, 84.07, 84.76, 37.82, 17.3, 65.48, 86.84, 39.33]\n",
      "Memórias brutas: [411.4, 436.6, 488.7, 533.1, 522.6, 485.2, 576.0, 516.3, 547.9, 786.6, 827.5, 876.2, 924.9, 964.8, 1004.0, 422.0, 215.7, 295.6, 399.4, 418.7, 344.0, 312.0, 220.2, 419.9, 281.0, 223.0, 223.0, 222.2, 223.2, 251.9, 292.2, 417.1, 233.0, 415.8, 418.8, 211.9]\n",
      "Espaço ocupado pelos dados: 647.19 MB\n"
     ]
    }
   ],
   "source": [
    "from psycopg2.extras import execute_values\n",
    "\n",
    "TAMANHO_LOTE = 10_000  # mesmo tamanho de lote para PostgreSQL e MongoDB\n",
    "\n",
    "\n",
    "def preparar_dados_postgres():\n",
    "    # Conversão dos dados para o formato do PostgreSQL: feita FORA da medição\n",
    "    rows_restaurantes = [\n",
    "        (r[\"pg_id\"], r[\"nome\"], r[\"categoria\"], r[\"ativo\"])\n",
    "        for r in restaurantes\n",
    "    ]\n",
    "    rows_itens = [\n",
    "        (\n",
    "            it[\"restaurante\"][\"pg_id\"],\n",
    "            it[\"nome\"],\n",
    "            it[\"categoria\"],\n",
    "            it[\"status\"],\n",
    "            json.dumps(it[\"preco\"], ensure_ascii=False),\n",
    "            json.dumps(it[\"opcoes_grupos\"], ensure_ascii=False),\n",
    "            json.dumps(it[\"atributos\"], ensure_ascii=False),\n",
    "            it[\"hash\"],\n",
    "            it[\"versao\"],\n",
    "        )\n",
    "        for it in itens\n",
    "    ]\n",
    "    return rows_restaurantes, rows_itens\n",
    "\n",
    "\n",
    "rows_restaurantes_pg, rows_itens_pg = preparar_dados_postgres()\n",
    "\n",
    "\n",
    "def inserir_postgres():\n",
    "    # Só o envio ao banco é cronometrado: inserção em lote, tudo em uma transação\n",
    "    conn = engine_pg.raw_connection()\n",
    "    try:\n",
    "        with conn.cursor() as cur:\n",
    "            execute_values(\n",
    "                cur,\n",
    "                \"INSERT INTO restaurantes (id, nome, categoria, ativo) VALUES %s\",\n",
    "                rows_restaurantes_pg,\n",
    "                page_size=TAMANHO_LOTE,\n",
    "            )\n",
    "            execute_values(\n",
    "                cur,\n",
    "                \"INSERT INTO itens (restaurante_id, nome, categoria, status, preco, opcoes_grupos, atributos_variaveis, hash, versao) VALUES %s\",\n",
    "                rows_itens_pg,\n",
    "                template=\"(%s, %s, %s, %s, %s::jsonb, %s::jsonb, %s::jsonb, %s, %s)\",\n",
    "                page_size=TAMANHO_LOTE,\n",
    "            )\n",
    "        conn.commit()\n",
    "    except Exception:\n",
    "        conn.rollback()\n",
    "        raise\n",
    "    finally:\n",
    "        conn.close()\n",
    "\n",
    "\n",
    "# Executa a inserção, monitorando CPU/memória apenas durante o envio ao banco\n",
    "resultado_insercao_pg = medir_insercao_com_recursos(inserir_postgres, \"catalogo-postgres-db\")\n",
    "\n",
    "espaco_dados_depois = medir_espaco_dados_pg(\"itens\")\n",
    "\n",
    "print(f\"PostgreSQL: {len(restaurantes)} restaurantes e {len(itens)} itens inseridos.\")\n",
    "print(f\"Tempo total: {resultado_insercao_pg['tempo_total_ms']:.0f} ms\")\n",
    "print(f\"CPU média: {resultado_insercao_pg['cpu_media_percent']:.2f}% (máx: {resultado_insercao_pg['cpu_max_percent']:.2f}%)\")\n",
    "print(f\"Memória média: {resultado_insercao_pg['memoria_media_mb']:.2f} MB (máx: {resultado_insercao_pg['memoria_max_mb']:.2f} MB)\")\n",
    "print(f\"Amostras coletadas: {resultado_insercao_pg['num_amostras']}\")\n",
    "print(f\"CPUs brutos: {resultado_insercao_pg['cpus_brutos']}\")\n",
    "print(f\"Memórias brutas: {resultado_insercao_pg['memorias_brutas']}\")\n",
    "print(f\"Espaço ocupado pelos dados: {espaco_dados_depois:.2f} MB\")"
   ]
  },
