    "###### <span style=\"font-size:1.6em\">PostgreSQL - Índice B-Tree (composto)</span>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "dd4afcb5",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
