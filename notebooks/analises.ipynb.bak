   "source": [
    "db_mongo.itens.drop_indexes()  # remove qualquer índice (mantém só o _id)\n",
    "\n",
    "# serve apenas para conferir o resultado, e também é usada para medir o tempo\n",
    "def consulta_c1_mongo(categoria=\"pizza\"):\n",
    "    cursor = db_mongo.itens.find(\n",
    "        {\"categoria\": categoria, \"status\": {\"$ne\": \"DELETED\"}},\n",
    "        {\"_id\": 0, \"nome\": 1, \"categoria\": 1, \"status\": 1}\n",
    "    )\n",
    "    return pd.DataFrame(list(cursor))\n",
    "\n",
    "# usada uma vez, só pra confirmar visualmente o plano de execução\n",
    "def explain_c1_mongo(categoria=\"pizza\"):\n",
    "    return db_mongo.command(\n",
    "        \"explain\",\n",
    "        {\n",
    "            \"find\": \"itens\",\n",
    "            \"filter\": {\"categoria\": categoria, \"status\": {\"$ne\": \"DELETED\"}},\n",
    "            \"projection\": {\"_id\": 0, \"nome\": 1, \"categoria\": 1, \"status\": 1},\n",
    "        },\n",
    "        verbosity=\"executionStats\"\n",
    "    )\n",
    "\n",
    "# Inspeciona os dados\n",
    "df_c1_mongo = consulta_c1_mongo()\n",
    "print(f\"MongoDB: {len(df_c1_mongo)} itens encontrados\")\n",
    "display(df_c1_mongo.head())\n",
    "\n",
    "# Confirma o plano de execução (não entra na medição de tempo)\n",
    "plano_c1_mongo = explain_c1_mongo()\n",
    "stage = encontrar_estagio_scan(plano_c1_mongo[\"queryPlanner\"][\"winningPlan\"])\n",
    "print(f\"Tipo de acesso usado: {stage}\")\n",
    "\n",
    "# Mede o tempo de execução (via cronometragem externa, uniforme com o Postgres)\n",
    "resultado_c1_mongo_sem_indice = medir_tempo(consulta_c1_mongo, repeats=10)\n",
    "print(f\"Min: {resultado_c1_mongo_sem_indice['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c1_mongo_sem_indice['max']:.2f} ms\")\n",
