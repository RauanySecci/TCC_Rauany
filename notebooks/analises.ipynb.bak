    "restaurante_teste_c2_mongo = restaurantes[0]\n",
    "id_teste_c2_mongo = ObjectId()\n",
    "contador_c2_mongo = {\"versao\": 0}\n",
    "\n",
    "def gerar_evento_c2_mongo(id_item=None, versao=None):\n",
    "    if versao is None:\n",
    "        contador_c2_mongo[\"versao\"] += 1\n",
    "        versao = contador_c2_mongo[\"versao\"]\n",
    "    categoria = \"lanche\"\n",
    "    nome = f\"Item Teste C2 v{versao}\"\n",
    "    status = \"AVAILABLE\"\n",
    "    atributos = gerar_atributos(categoria)\n",
    "    preco = gerar_preco_json(categoria, atributos)\n",
    "    opcoes_grupos = gerar_opcoes_grupos(categoria, restaurante_teste_c2_mongo)\n",
    "    hash_novo = calcular_hash(nome, categoria, status, preco, opcoes_grupos, atributos)\n",
    "    agora = datetime.now()\n",
    "    doc = {\n",
    "        \"_id\": id_item if id_item is not None else id_teste_c2_mongo,\n",
    "        \"restauranteId\": restaurante_teste_c2_mongo[\"mongo_id\"],\n",
    "        \"nome\": nome,\n",
    "        \"categoria\": categoria,\n",
    "        \"status\": status,\n",
    "        \"preco\": preco,\n",
    "        \"opcoes_grupos\": opcoes_grupos,\n",
    "        \"hash\": hash_novo,\n",
    "        \"versao\": versao,\n",
    "        \"criado_em\": agora,\n",
    "        \"modificado_em\": agora,\n",
    "    }\n",
    "    doc.update(atributos)\n",
    "    return doc\n",
    "\n",
    "def upsert_c2_mongo(evento):\n",
    "    \"\"\"\n",
    "    A checagem de hash/versão precisa ser feita na aplicação: primeiro\n",
    "    BUSCA o documento existente, e só depois decide se escreve — o\n",
    "    MongoDB não tem um operador nativo equivalente ao WHERE hash <> do Postgres.\n",
    "    \"\"\"\n",
    "    existente = db_mongo.itens.find_one({\"_id\": evento[\"_id\"]})\n",
    "\n",
    "    if existente is None:\n",
    "        db_mongo.itens.insert_one(evento)\n",
    "    elif existente[\"hash\"] != evento[\"hash\"] and evento[\"versao\"] >= existente[\"versao\"]:\n",
    "        evento[\"criado_em\"] = existente[\"criado_em\"]  # replace não pode apagar a data de criação\n",
    "        db_mongo.itens.replace_one({\"_id\": evento[\"_id\"]}, evento)\n",
    "    # senão: não faz nada (idempotência)\n",
    "\n",
    "# Gera os eventos ANTES de medir, mesma lógica do Postgres\n",
    "eventos_c2_mongo = [gerar_evento_c2_mongo() for _ in range(11)]\n",
    "contador_evento_mongo = iter(eventos_c2_mongo)\n",
    "\n",
    "def acao_c2_mongo():\n",
    "    upsert_c2_mongo(next(contador_evento_mongo))\n",
    "\n",
    "resultado_c2_mongo = medir_tempo(acao_c2_mongo, repeats=10)\n",
    "print(\"C2 - Atualização (o item já existe; o aquecimento descartado fez a inserção)\")\n",
    "print(f\"Min: {resultado_c2_mongo['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c2_mongo['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c2_mongo['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c2_mongo['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c2_mongo['tempos_brutos']}\")\n",
    "\n",
    "# Inserção: cada execução envia um item NOVO (id diferente), então cai no caminho do INSERT\n",
    "ids_insercao_c2_mongo = [ObjectId() for _ in range(11)]\n",
    "eventos_insercao_c2_mongo = iter([gerar_evento_c2_mongo(i) for i in ids_insercao_c2_mongo])\n",
    "\n",
    "def acao_c2_insercao_mongo():\n",
    "    upsert_c2_mongo(next(eventos_insercao_c2_mongo))\n",
    "\n",
    "resultado_c2_mongo_insercao = medir_tempo(acao_c2_insercao_mongo, repeats=10)\n",
    "print(\"C2 - Inserção (item novo a cada execução)\")\n",
    "print(f\"Min: {resultado_c2_mongo_insercao['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c2_mongo_insercao['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c2_mongo_insercao['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c2_mongo_insercao['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c2_mongo_insercao['tempos_brutos']}\")\n",
    "\n",
    "# Remove os itens inseridos pelo teste\n",
    "db_mongo.itens.delete_many({\"_id\": {\"$in\": ids_insercao_c2_mongo}})"
   ]
