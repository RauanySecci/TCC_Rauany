   ],
   "source": [
    "apagar_indices_pg()  # remove qualquer índice\n",
    "\n",
    "# Cria o índice B-tree composto para C1 (categoria + status)\n",
    "with engine_pg.begin() as conn:\n",
    "    conn.execute(text(\"CREATE INDEX btree_c1 ON itens (categoria, status)\"))\n",
    "    conn.execute(text(\"ANALYZE itens\"))\n",
    "\n",
    "# Confirma o plano de execução\n",
    "plano_c1_pg_btree = explain_c1_pg()\n",
    "node_type = plano_c1_pg_btree[\"Plan\"][\"Node Type\"]\n",
    "indice_usado = extrair_nome_indice(plano_c1_pg_btree)\n",
    "\n",
    "print(f\"Índice: {indice_usado} | Tipo de acesso: {node_type}\")\n",
    "\n",
    "# Mede o tempo de execução\n",
    "resultado_c1_pg_btree = medir_tempo(consulta_c1_pg, repeats=10)\n",
    "print(f\"Min: {resultado_c1_pg_btree['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c1_pg_btree['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c1_pg_btree['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c1_pg_btree['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c1_pg_btree['tempos_brutos']}\")\n",
    "\n",
    "# Mede o espaço em disco ocupado pelo índice\n",
    "espaco_indice_c1_pg = medir_espaco_indice_pg(\"itens\")\n",
    "print(f\"Espaço ocupado pelo índice: {espaco_indice_c1_pg:.2f} MB\")"
   ]
