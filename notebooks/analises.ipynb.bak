      "File \u001b[0;32m/usr/lib/python3.10/json/__init__.py:346\u001b[0m, in \u001b[0;36mloads\u001b[0;34m(s, cls, object_hook, parse_float, parse_int, parse_constant, object_pairs_hook, **kw)\u001b[0m\n\u001b[1;32m    341\u001b[0m     s \u001b[38;5;241m=\u001b[39m s\u001b[38;5;241m.\u001b[39mdecode(detect_encoding(s), \u001b[38;5;124m'\u001b[39m\u001b[38;5;124msurrogatepass\u001b[39m\u001b[38;5;124m'\u001b[39m)\n\u001b[1;32m    343\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m (\u001b[38;5;28mcls\u001b[39m \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m \u001b[38;5;129;01mand\u001b[39;00m object_hook \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m \u001b[38;5;129;01mand\u001b[39;00m\n\u001b[1;32m    344\u001b[0m         parse_int \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m \u001b[38;5;129;01mand\u001b[39;00m parse_float \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m \u001b[38;5;129;01mand\u001b[39;00m\n\u001b[1;32m    345\u001b[0m         parse_constant \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m \u001b[38;5;129;01mand\u001b[39;00m object_pairs_hook \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m \u001b[38;5;129;01mand\u001b[39;00m \u001b[38;5;129;01mnot\u001b[39;00m kw):\n\u001b[0;32m--> 346\u001b[0m     \u001b[38;5;28;01mreturn\u001b[39;00m \u001b[43m_default_decoder\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mdecode\u001b[49m\u001b[43m(\u001b[49m\u001b[43ms\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    347\u001b[0m \u001b[38;5;28;01mif\u001b[39;00m \u001b[38;5;28mcls\u001b[39m \u001b[38;5;129;01mis\u001b[39;00m \u001b[38;5;28;01mNone\u001b[39;00m:\n\u001b[1;32m    348\u001b[0m     \u001b[38;5;28mcls\u001b[39m \u001b[38;5;241m=\u001b[39m JSONDecoder\n",
      "File \u001b[0;32m/usr/lib/python3.10/json/decoder.py:337\u001b[0m, in \u001b[0;36mJSONDecoder.decode\u001b[0;34m(self, s, _w)\u001b[0m\n\u001b[1;32m    332\u001b[0m \u001b[38;5;28;01mdef\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;21mdecode\u001b[39m(\u001b[38;5;28mself\u001b[39m, s, _w\u001b[38;5;241m=\u001b[39mWHITESPACE\u001b[38;5;241m.\u001b[39mmatch):\n\u001b[1;32m    333\u001b[0m \u001b[38;5;250m    \u001b[39m\u001b[38;5;124;03m\"\"\"Return the Python representation of ``s`` (a ``str`` instance\u001b[39;00m\n\u001b[1;32m    334\u001b[0m \u001b[38;5;124;03m    containing a JSON document).\u001b[39;00m\n\u001b[1;32m    335\u001b[0m \n\u001b[1;32m    336\u001b[0m \u001b[38;5;124;03m    \"\"\"\u001b[39;00m\n\u001b[0;32m--> 337\u001b[0m     obj, end \u001b[38;5;241m=\u001b[39m \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mraw_decode\u001b[49m\u001b[43m(\u001b[49m\u001b[43ms\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43midx\u001b[49m\u001b[38;5;241;43m=\u001b[39;49m\u001b[43m_w\u001b[49m\u001b[43m(\u001b[49m\u001b[43ms\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[38;5;241;43m0\u001b[39;49m\u001b[43m)\u001b[49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mend\u001b[49m\u001b[43m(\u001b[49m\u001b[43m)\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    338\u001b[0m     end \u001b[38;5;241m=\u001b[39m _w(s, end)\u001b[38;5;241m.\u001b[39mend()\n\u001b[1;32m    339\u001b[0m     \u001b[38;5;28;01mif\u001b[39;00m end \u001b[38;5;241m!=\u001b[39m \u001b[38;5;28mlen\u001b[39m(s):\n",
      "File \u001b[0;32m/usr/lib/python3.10/json/decoder.py:353\u001b[0m, in \u001b[0;36mJSONDecoder.raw_decode\u001b[0;34m(self, s, idx)\u001b[0m\n\u001b[1;32m    344\u001b[0m \u001b[38;5;250m\u001b[39m\u001b[38;5;124;03m\"\"\"Decode a JSON document from ``s`` (a ``str`` beginning with\u001b[39;00m\n\u001b[1;32m    345\u001b[0m \u001b[38;5;124;03ma JSON document) and return a 2-tuple of the Python\u001b[39;00m\n\u001b[1;32m    346\u001b[0m \u001b[38;5;124;03mrepresentation and the index in ``s`` where the document ended.\u001b[39;00m\n\u001b[0;32m   (...)\u001b[0m\n\u001b[1;32m    350\u001b[0m \n\u001b[1;32m    351\u001b[0m \u001b[38;5;124;03m\"\"\"\u001b[39;00m\n\u001b[1;32m    352\u001b[0m \u001b[38;5;28;01mtry\u001b[39;00m:\n\u001b[0;32m--> 353\u001b[0m     obj, end \u001b[38;5;241m=\u001b[39m \u001b[38;5;28;43mself\u001b[39;49m\u001b[38;5;241;43m.\u001b[39;49m\u001b[43mscan_once\u001b[49m\u001b[43m(\u001b[49m\u001b[43ms\u001b[49m\u001b[43m,\u001b[49m\u001b[43m \u001b[49m\u001b[43midx\u001b[49m\u001b[43m)\u001b[49m\n\u001b[1;32m    354\u001b[0m \u001b[38;5;28;01mexcept\u001b[39;00m \u001b[38;5;167;01mStopIteration\u001b[39;00m \u001b[38;5;28;01mas\u001b[39;00m err:\n\u001b[1;32m    355\u001b[0m     \u001b[38;5;28;01mraise\u001b[39;00m JSONDecodeError(\u001b[38;5;124m\"\u001b[39m\u001b[38;5;124mExpecting value\u001b[39m\u001b[38;5;124m\"\u001b[39m, s, err\u001b[38;5;241m.\u001b[39mvalue) \u001b[38;5;28;01mfrom\u001b[39;00m\u001b[38;5;250m \u001b[39m\u001b[38;5;28;01mNone\u001b[39;00m\n",
      "\u001b[0;31mKeyboardInterrupt\u001b[0m: "
     ]
    }
   ],
   "source": [
    "preparar_ambiente(*PRESETS[PRESET_SELETIVIDADE])\n",
    "parametros_seletividade = montar_parametros_seletividade()\n",
    "\n",
    "resultados_seletividade = {}  # {consulta: {cenario: {rotulo_parametro: resultado_medir_tempo}}}\n",
    "\n",
    "for nome_consulta, parametros in parametros_seletividade.items():\n",
    "    resultados_seletividade[nome_consulta] = {}\n",
    "    for cenario in CENARIOS_ESCALABILIDADE[nome_consulta]:\n",
    "        cenario[\"preparar\"]()  # índice criado uma vez por cenário\n",
    "        resultados_seletividade[nome_consulta][cenario[\"label\"]] = {}\n",
    "        for rotulo, valor in parametros:\n",
    "            resultado = medir_tempo(lambda: chamar(cenario[\"acao\"], valor), repeats=10)\n",
    "            resultado[\"n_resultados\"] = len(chamar(cenario[\"acao\"], valor))\n",
    "            resultados_seletividade[nome_consulta][cenario[\"label\"]][rotulo] = resultado\n",
    "            print(f\"{nome_consulta} | {cenario['label']} | {rotulo}: \"\n",
    "                  f\"{resultado['n_resultados']} linhas, média {resultado['media']:.2f} ms\")\n",
    "\n",
    "with open(CAMINHO_RESULTADOS_SELETIVIDADE, \"w\", encoding=\"utf-8\") as f:\n",
    "    json.dump(resultados_seletividade, f, ensure_ascii=False, indent=2)\n",
    "print(f\"Resultados salvos em {CAMINHO_RESULTADOS_SELETIVIDADE}.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "42117ebb",
   "metadata": {},
   "source": [
    "### Lote de escrita"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "da24646c",
   "metadata": {},
   "source": [
    "Mede **quantos itens chegam por vez numa única operação**: o custo *por item* melhora ou piora conforme o lote cresce? A partir de que tamanho começa a piorar?\n",
    "\n",
    "Cada operação é executada com lotes de `LOTES` itens (1, 10, 100, 1.000, 10.000), mantendo o volume do banco fixo (`PRESET_LOTE`):\n",
    "\n",
    "| Consulta | Operação em lote |\n",
    "|---|---|\n",
    "| C2 - Inserção | Upsert de N itens que ainda não existem (os itens são apagados antes de cada repetição) |\n",
    "| C2 - Atualização | Upsert de N itens que já existem (atualiza só se o `hash` mudou e a `versao` não é mais antiga) |\n",
    "| C8 | Adiciona a tag `novidade` a N itens já existentes (atualização dentro do JSONB) |\n",
    "| C3 | Soft delete (`status = 'DELETED'`) de N itens |\n",
    "\n",
    "Em todas as operações o estado original é restaurado antes de cada repetição, fora da cronometragem, e a escrita faz commit nos dois bancos.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "45ddc581",
   "metadata": {},
   "outputs": [],
   "source": [
    "from psycopg2.extras import execute_values\n",
    "from pymongo import InsertOne, ReplaceOne\n",
    "\n",
    "CAMINHO_RESULTADOS_LOTE = \"resultados_lote.json\"\n",
    "PRESET_LOTE = \"Grande\"  # volume fixo em que o lote de escrita é medido\n",
    "LOTES = [1, 10, 100, 1_000, 10_000]  # itens por operação\n",
    "\n",
    "def preparar_ambiente(num_restaurantes, num_itens):\n",
    "    resetar_schema()\n",
    "    gerar_dados(num_restaurantes, num_itens)\n",
    "    inserir_postgres()\n",
    "    inserir_mongo()\n",
    "\n",
    "def amostrar_ids(maximo):\n",
    "    with engine_pg.connect() as conn:\n",
    "        ids_pg = [r[0] for r in conn.execute(text(\n",
    "            \"SELECT id::text FROM itens WHERE status <> 'DELETED' ORDER BY random() LIMIT :n\"\n",
    "        ), {\"n\": maximo})]\n",
    "    ids_mongo = [d[\"_id\"] for d in db_mongo.itens.aggregate([\n",
    "        {\"$match\": {\"status\": {\"$ne\": \"DELETED\"}}},\n",
    "        {\"$sample\": {\"size\": maximo}},\n",
    "        {\"$project\": {\"_id\": 1}},\n",
    "    ])]\n",
    "    return {\"PostgreSQL\": ids_pg, \"MongoDB\": ids_mongo}\n",
    "\n",
    "# Cada fábrica recebe (n, ids) e devolve (antes, acao, depois):\n",
    "#   antes  -> roda antes de cada repetição, fora do tempo (prepara/restaura)\n",
    "#   acao   -> a operação em lote, cronometrada\n",
    "#   depois -> limpeza ao fim das repetições daquele tamanho de lote\n",
    "\n",
    "# C2 — upsert em lote\n",
    "SQL_UPSERT_LOTE_C2_PG = (\n",
    "    \"INSERT INTO itens (id, restaurante_id, nome, categoria, status, preco, opcoes_grupos, \"\n",
    "    \"atributos_variaveis, hash, versao) VALUES %s ON CONFLICT\"\n",
    "    + SQL_UPSERT_C2_PG.split(\"ON CONFLICT\", 1)[1]\n",
    ")\n",
    "TEMPLATE_C2_PG = \"(%s, %s, %s, %s, %s, %s::jsonb, %s::jsonb, %s::jsonb, %s, %s)\"\n",
    "COLUNAS_C2_PG = [\"id\", \"restaurante_id\", \"nome\", \"categoria\", \"status\", \"preco\",\n",
    "                 \"opcoes_grupos\", \"atributos\", \"hash\", \"versao\"]\n",
    "\n",
    "def upsert_lote_c2_pg(eventos):\n",
    "    linhas = [tuple(e[c] for c in COLUNAS_C2_PG) for e in eventos]\n",
    "    conn = engine_pg.raw_connection()\n",
    "    try:\n",
    "        with conn.cursor() as cur:\n",
    "            execute_values(cur, SQL_UPSERT_LOTE_C2_PG, linhas,\n",
    "                           template=TEMPLATE_C2_PG, page_size=len(linhas))  # uma única instrução\n",
    "        conn.commit()\n",
    "    finally:\n",
    "        conn.close()\n",
    "\n",
    "def upsert_lote_c2_mongo(eventos):\n",
    "    existentes = {d[\"_id\"]: d for d in db_mongo.itens.find(\n",
    "        {\"_id\": {\"$in\": [e[\"_id\"] for e in eventos]}}, {\"hash\": 1, \"versao\": 1, \"criado_em\": 1})}\n",
    "    ops = []\n",
    "    for evento in eventos:\n",
    "        existente = existentes.get(evento[\"_id\"])\n",
    "        if existente is None:\n",
    "            ops.append(InsertOne(evento))\n",
    "        elif existente[\"hash\"] != evento[\"hash\"] and evento[\"versao\"] >= existente[\"versao\"]:\n",
    "            evento[\"criado_em\"] = existente[\"criado_em\"]\n",
    "            ops.append(ReplaceOne({\"_id\": evento[\"_id\"]}, evento))\n",
    "    if ops:\n",
    "        db_mongo.itens.bulk_write(ops, ordered=False)\n",
    "\n",
    "def criar_fabrica_c2_pg(modo):\n",
    "    # modo \"insercao\": os itens são apagados no `antes`, então toda repetição cai no INSERT\n",
    "    # modo \"atualizacao\": os itens já existem (o aquecimento descartado os insere), então\n",
    "    #                     as repetições medidas caem no caminho do DO UPDATE\n",
    "    def fabrica(n, ids):\n",
    "        ids_novos = [str(uuid.uuid4()) for _ in range(n)]\n",
    "        estado = {\"versao\": 0, \"eventos\": None}\n",
    "\n",
    "        def apagar():\n",
    "            with engine_pg.begin() as conn:\n",
    "                conn.execute(text(\"DELETE FROM itens WHERE id = ANY(CAST(:ids AS uuid[]))\"), {\"ids\": ids_novos})\n",
    "\n",
    "        def antes():\n",
    "            if modo == \"insercao\":\n",
    "                apagar()\n",
    "            # eventos gerados fora do tempo, como se já tivessem chegado prontos da fila\n",
    "            estado[\"versao\"] += 1\n",
    "            estado[\"eventos\"] = [gerar_evento_c2_pg(i, estado[\"versao\"]) for i in ids_novos]\n",
    "\n",
    "        def acao():\n",
    "            upsert_lote_c2_pg(estado[\"eventos\"])\n",
    "\n",
    "        return antes, acao, apagar\n",
    "    return fabrica\n",
    "\n",
    "def criar_fabrica_c2_mongo(modo):\n",
    "    def fabrica(n, ids):\n",
    "        ids_novos = [ObjectId() for _ in range(n)]\n",
    "        estado = {\"versao\": 0, \"eventos\": None}\n",
    "\n",
    "        def apagar():\n",
    "            db_mongo.itens.delete_many({\"_id\": {\"$in\": ids_novos}})\n",
    "\n",
    "        def antes():\n",
    "            if modo == \"insercao\":\n",
    "                apagar()\n",
    "            estado[\"versao\"] += 1\n",
    "            estado[\"eventos\"] = [gerar_evento_c2_mongo(i, estado[\"versao\"]) for i in ids_novos]\n",
    "\n",
    "        def acao():\n",
    "            upsert_lote_c2_mongo(estado[\"eventos\"])\n",
    "\n",
    "        return antes, acao, apagar\n",
    "    return fabrica\n",
    "\n",
    "# C8 e C3 — o estado original é restaurado no `antes` (e ao final, no `depois`), nos dois bancos.\n",
    "# No PostgreSQL a ação faz COMMIT, igual ao C2 e ao MongoDB (que não tem rollback)\n",
    "def fabrica_pg_com_restauracao(acao_pg, colunas, jsonb=()):\n",
    "    def fabrica(n, ids):\n",
    "        snapshot = tirar_snapshot_pg(ids, colunas)\n",
    "        restaurar = lambda: restaurar_snapshot_pg(snapshot, colunas, jsonb)\n",
    "        return restaurar, lambda: acao_pg(ids), restaurar\n",
    "    return fabrica\n",
    "\n",
    "def fabrica_mongo_com_restauracao(acao_mongo, campos):\n",
    "    def fabrica(n, ids):\n",
    "        snapshot = tirar_snapshot_mongo(ids, campos)\n",
    "        restaurar = lambda: restaurar_snapshot_mongo(snapshot, campos)\n",
    "        return restaurar, lambda: acao_mongo(ids), restaurar\n",
    "    return fabrica\n",
    "\n",
    "fabrica_c8_pg = fabrica_pg_com_restauracao(acao_c8_pg, [\"atributos_variaveis\", \"modificado_em\"], jsonb=(\"atributos_variaveis\",))\n",
    "fabrica_c3_pg = fabrica_pg_com_restauracao(acao_c3_pg, [\"status\", \"hash\", \"modificado_em\"])\n",
    "fabrica_c8_mongo = fabrica_mongo_com_restauracao(acao_c8_mongo, [\"tags\", \"modificado_em\"])\n",
    "fabrica_c3_mongo = fabrica_mongo_com_restauracao(acao_c3_mongo, [\"status\", \"hash\", \"modificado_em\"])\n",
    "\n",
    "FABRICAS_LOTE = {\n",
    "    \"C2 - Inserção\": {\"PostgreSQL\": criar_fabrica_c2_pg(\"insercao\"), \"MongoDB\": criar_fabrica_c2_mongo(\"insercao\")},\n",
    "    \"C2 - Atualização\": {\"PostgreSQL\": criar_fabrica_c2_pg(\"atualizacao\"), \"MongoDB\": criar_fabrica_c2_mongo(\"atualizacao\")},\n",
    "    \"C8\": {\"PostgreSQL\": fabrica_c8_pg, \"MongoDB\": fabrica_c8_mongo},\n",
    "    \"C3\": {\"PostgreSQL\": fabrica_c3_pg, \"MongoDB\": fabrica_c3_mongo},\n",
    "}"
   ]
  },
