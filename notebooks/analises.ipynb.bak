   "source": [
    "db_mongo.itens.drop_indexes()\n",
    "\n",
    "def consulta_c5_mongo(minimo=20, maximo=50):\n",
    "    cursor = db_mongo.itens.find(\n",
    "        {\"preco.valor\": {\"$gte\": minimo, \"$lte\": maximo}, \"status\": {\"$ne\": \"DELETED\"}},\n",
    "        {\"_id\": 0, \"nome\": 1, \"categoria\": 1, \"preco\": 1}\n",
    "    )\n",
    "    return pd.DataFrame(list(cursor))\n",
    "\n",
    "def explain_c5_mongo(minimo=20, maximo=50):\n",
    "    return db_mongo.command(\n",
    "        \"explain\",\n",
    "        {\n",
    "            \"find\": \"itens\",\n",
    "            \"filter\": {\"preco.valor\": {\"$gte\": minimo, \"$lte\": maximo}, \"status\": {\"$ne\": \"DELETED\"}},\n",
    "            \"projection\": {\"_id\": 0, \"nome\": 1, \"categoria\": 1, \"preco\": 1},\n",
    "        },\n",
    "        verbosity=\"executionStats\"\n",
    "    )\n",
    "\n",
    "# Inspeciona os dados\n",
    "df_c5_mongo = consulta_c5_mongo()\n",
    "print(f\"MongoDB: {len(df_c5_mongo)} itens encontrados\")\n",
    "display(df_c5_mongo.head())\n",
    "\n",
    "# Confirma o plano de execução\n",
    "plano_c5_mongo = explain_c5_mongo()\n",
    "stage = encontrar_estagio_scan(plano_c5_mongo[\"queryPlanner\"][\"winningPlan\"])\n",
    "print(f\"Tipo de acesso usado: {stage}\")\n",
    "\n",
    "# Mede o tempo de execução\n",
    "resultado_c5_mongo_sem_indice = medir_tempo(consulta_c5_mongo, repeats=10)\n",
    "print(f\"Min: {resultado_c5_mongo_sem_indice['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c5_mongo_sem_indice['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c5_mongo_sem_indice['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c5_mongo_sem_indice['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c5_mongo_sem_indice['tempos_brutos']}\")"
   ]
  },
