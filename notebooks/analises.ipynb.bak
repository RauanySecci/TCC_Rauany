   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Item de teste: 6ace8796d8f306ef80a25ead\n",
      "Antes: {'status': 'AVAILABLE'}\n",
      "Min: 1.46 ms\n",
      "Max: 2.44 ms\n",
      "Média: 1.91 ms\n",
      "Mediana: 1.88 ms\n",
      "Tempos brutos: [2.2841640002297936, 1.5659780001442414, 2.1663529996658326, 1.6414229999099916, 1.9352859999344219, 1.5045380000628938, 1.4598910001950571, 2.4431430001641274, 1.8150820001210377, 2.2812289998910273]\n",
      "Depois (restaurado): {'status': 'AVAILABLE'}\n"
     ]
    }
   ],
   "source": [
    "from datetime import datetime\n",
    "\n",
    "# Pega um item real do banco\n",
    "item_id_teste_mongo = db_mongo.itens.find_one({\"status\": {\"$ne\": \"DELETED\"}})[\"_id\"]\n",
    "\n",
    "def consulta_c3_mongo():\n",
    "    return db_mongo.itens.find_one({\"_id\": item_id_teste_mongo}, {\"_id\": 0, \"status\": 1})\n",
    "\n",
    "COLUNAS_C3_MONGO = [\"status\", \"hash\", \"modificado_em\"]\n",
    "snapshot_c3_mongo = tirar_snapshot_mongo([item_id_teste_mongo], COLUNAS_C3_MONGO)\n",
    "restaurar_c3_mongo = lambda: restaurar_snapshot_mongo(snapshot_c3_mongo, COLUNAS_C3_MONGO)\n",
    "\n",
    "def acao_c3_mongo(ids=None):\n",
    "    # sem argumento: o item de teste; com uma lista de ids: delete lógico em lote.\n",
    "    # O estado original é restaurado pelo `antes` do medir_tempo, fora da cronometragem,\n",
    "    # garantindo que cada repetição meça uma transição real (AVAILABLE → DELETED)\n",
    "    if ids is None:\n",
    "        ids = [item_id_teste_mongo]\n",
    "    db_mongo.itens.update_many(\n",
    "        {\"_id\": {\"$in\": ids}, \"status\": {\"$ne\": \"DELETED\"}},\n",
    "        {\"$set\": {\"status\": \"DELETED\", \"hash\": 0, \"modificado_em\": datetime.now()}}\n",
    "    )\n",
    "\n",
    "# Inspeciona o item antes do benchmark\n",
    "print(f\"Item de teste: {item_id_teste_mongo}\")\n",
    "print(\"Antes:\", consulta_c3_mongo())\n",
    "\n",
    "resultado_c3_mongo = medir_tempo(acao_c3_mongo, repeats=10, antes=restaurar_c3_mongo)\n",
    "print(f\"Min: {resultado_c3_mongo['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c3_mongo['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c3_mongo['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c3_mongo['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c3_mongo['tempos_brutos']}\")\n",
    "\n",
    "# Restaura o item ao estado original, pra não deixar \"deletado\" de propósito\n",
    "restaurar_c3_mongo()\n",
    "print(\"Depois (restaurado):\", consulta_c3_mongo())"
   ]
  },
  {
   "cell_type": "markdown",
