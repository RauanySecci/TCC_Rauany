   "source": [
    "apagar_indices_pg()  # remove qualquer índice\n",
    "\n",
    "def consulta_c4_pg(nome_restaurante_teste=None):\n",
    "    if nome_restaurante_teste is None:\n",
    "        nome_restaurante_teste = restaurantes[0][\"nome\"]\n",
    "    return pd.read_sql(\n",
    "        text(\n",
    "            \"SELECT i.nome, i.categoria, i.status, r.nome AS restaurante_nome \"\n",
    "            \"FROM itens i JOIN restaurantes r ON r.id = i.restaurante_id \"\n",
    "            \"WHERE r.nome = :nome AND i.status <> 'DELETED'\"\n",
    "        ),\n",
    "        engine_pg,\n",
    "        params={\"nome\": nome_restaurante_teste}\n",
    "    )\n",
    "\n",
    "def explain_c4_pg(nome_restaurante_teste=None):\n",
    "    if nome_restaurante_teste is None:\n",
    "        nome_restaurante_teste = restaurantes[0][\"nome\"]\n",
    "    with engine_pg.connect() as conn:\n",
    "        resultado = conn.execute(text(\n",
    "            \"EXPLAIN (ANALYZE, FORMAT JSON) \"\n",
    "            \"SELECT i.nome, i.categoria, i.status, r.nome AS restaurante_nome \"\n",
    "            \"FROM itens i JOIN restaurantes r ON r.id = i.restaurante_id \"\n",
    "            \"WHERE r.nome = :nome AND i.status <> 'DELETED'\"\n",
    "        ), {\"nome\": nome_restaurante_teste}).scalar()\n",
    "        return resultado[0]\n",
    "\n",
    "# Inspeciona os dados\n",
    "df_c4_pg = consulta_c4_pg()\n",
    "print(f\"PostgreSQL: {len(df_c4_pg)} itens encontrados\")\n",
    "display(df_c4_pg.head())\n",
    "\n",
    "# Confirma o plano de execução\n",
    "plano_c4_pg = explain_c4_pg()\n",
    "node_type = plano_c4_pg[\"Plan\"][\"Node Type\"]\n",
    "print(f\"Tipo de acesso usado: {node_type}\")\n",
    "\n",
    "# Mede o tempo de execução\n",
    "resultado_c4_pg_sem_indice = medir_tempo(consulta_c4_pg, repeats=10)\n",
    "print(f\"Min: {resultado_c4_pg_sem_indice['min']:.2f} ms\")\n",
    "print(f\"Max: {resultado_c4_pg_sem_indice['max']:.2f} ms\")\n",
    "print(f\"Média: {resultado_c4_pg_sem_indice['media']:.2f} ms\")\n",
    "print(f\"Mediana: {resultado_c4_pg_sem_indice['mediana']:.2f} ms\")\n",
    "print(f\"Tempos brutos: {resultado_c4_pg_sem_indice['tempos_brutos']}\")"
   ]
